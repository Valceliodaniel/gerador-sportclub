datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String // Guardaremos a senha criptografada aqui
}

